{
  "name": "tohoku-yokairoku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser.js && node tests/presentation.js && node tests/manuscript.js && node tests/journey.js",
