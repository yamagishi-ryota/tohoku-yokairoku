    "build:offline": "node scripts/build-offline.js",
    "test:offline": "node tests/offline.js",
    "package:offline": "npm run build:offline && python3 scripts/package-offline.py"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
